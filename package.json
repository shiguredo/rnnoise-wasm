{
  "name": "@shiguredo/rnnoise-wasm",
  "version": "2025.1.0",
  "description": "SIMD-accelerated WebAssembly build of RNNoise",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/rnnoise.d.ts",
      "import": "./dist/rnnoise.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "lint": "biome lint",
    "fmt": "biome format --write",
    "test": "vitest run",
    "doc": "typedoc",
    "dev": "vite dev --config example/vite.config.ts",
    "preview": "vite preview --config example/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiguredo/rnnoise-wasm.git"
  },
  "keywords": ["rnnoise", "noise-suppression"],
  "author": "Shiguredo Inc.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://discord.gg/shiguredo"
  },
  "homepage": "https://github.com/shiguredo/rnnoise-wasm#readme",
  "files": ["dist"],
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/emscripten": "1.40.1",
    "tslib": "2.8.1",
    "typedoc": "0.28.3",
    "typescript": "5.8.3",
    "vite": "6.3.4",
    "vite-plugin-dts": "4.5.3",
    "vite-plugin-static-copy": "2.3.1",
    "vitest": "3.1.2",
    "wasm-feature-detect": "1.8.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
